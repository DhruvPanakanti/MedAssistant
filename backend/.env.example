# Fill in your own values below. This file is already excluded by
# .gitignore, so it will never be committed or pushed to GitHub — safe
# to put real keys and passwords here.
#
# After editing, just run the app normally (python app.py). No need to
# set environment variables manually each session — config_loader.py
# loads this file automatically every time the app starts.
#
# Lines are commented out (#) by default. Uncomment (remove the #) and
# fill in a value only for the settings you actually want to change —
# an uncommented blank value (e.g. ADMIN_USERNAME=) would override the
# app's built-in default with an empty value, which breaks the login.

# Required only if you want the Gemini-powered chatbot layer. Get a
# free key at https://aistudio.google.com/apikey
# Leave commented out to use the rule-based chatbot only (no key needed).
# GEMINI_API_KEY=your-key-here

# Optional — override which Gemini model is used.
# Defaults to gemini-3.6-flash if left commented out.
# GEMINI_MODEL=gemini-3.6-flash

# Optional — admin login credentials for /login and /admin/thresholds.
# Defaults to admin / admin123 if left commented out. Change these
# before any real deployment.
# ADMIN_USERNAME=your_username
# ADMIN_PASSWORD=your_password

# Optional — Flask session secret key. Set a real random string before
# any real deployment; the app uses a placeholder default otherwise.
# FLASK_SECRET_KEY=some-long-random-string
